-inline bool fuel_ok(std::uint64_t need) { return bc::fuel_remaining() > need + FUEL_RESERVE; }
+// det-fuel (10-24, kvvl-det v8): decisions must not depend on the fuel left. Any code change shifts the real fuel
+// use of every turn, which flips some fuel_ok() from round 2 on, so online A/B pairs diverged by r3 and a 20-instruction
+// probe changed 248/312 local games. fuel_ok() now reads a deterministic meter g_dm: each play_turn section (FP marks)
+// is charged DM_BASE[section][foes within 10], each check DM_CALL, and a check that lets dear work through charges that
+// work (fuel_okc(need, charge); charges = mean real cost after the check, 52 games). Fitted so the meter averages the
+// real fuel per section. The real fuel only vetoes below DM_EMERG (heavy turns; counted as dm=meter/vetoes in the
+// status line). Local 312 g: same strength as kvvl; the probe now changes 33 games before r300 (kvvl 105).
+std::uint64_t g_dm = 0;   // this turn's charged fuel so far
+int g_dm_sec = 0;         // current FP section (0 pre-sweep .. 13 log, 21-29 init parts)
+int g_dm_turn = 0;        // turns played (the first turn has a 2x budget)
+int g_dm_emerg = 0;       // vetoes by the real fuel (counter, status line)
+constexpr std::uint64_t DM_Q = 99000;
+constexpr std::uint64_t DM_CALL = 400;
+constexpr std::uint64_t DM_EMERG = 9000;
+// A purchase (gold spent in shop()) is charged 70000 after the fact.
+int g_dm_nf = 0;  // foes within 10 (set in play_turn after the foe scan; kept to the next turn's pre-sweep)
+// Base charge per section (rows 0 pre-sweep .. 13 log) by foes within 10 (columns 0..4+).
+constexpr std::uint64_t DM_BASE[14][5] = {
+    {0, 700, 2000, 2700, 3300},
+    {600, 300, 0, 0, 0},
+    {0, 0, 0, 0, 0},
+    {2500, 2300, 2300, 2400, 2500},
+    {4000, 3700, 3800, 3900, 4000},
+    {1700, 5400, 9400, 14000, 17300},
+    {4800, 5200, 5700, 6300, 6000},
+    {400, 400, 400, 400, 400},
+    {400, 700, 1100, 1400, 1400},
+    {3500, 5600, 7400, 11000, 16700},
+    {1900, 1900, 2900, 4100, 4600},
+    {2500, 3700, 6400, 6300, 6500},
+    {0, 0, 0, 0, 0},
+    {100, 100, 100, 100, 100}};
+inline std::uint64_t dm_cost(int sec) {
+    const int nf = g_dm_nf < 0 ? 0 : g_dm_nf > 4 ? 4 : g_dm_nf;
+    if (sec >= 0 && sec < 14) return DM_BASE[sec][nf];
+    switch (sec) {
+        case 21: return 170000;            // init-groups (first turn, 2x budget)
+        case 22: return 2200;
+        case 23: return 4300;
+        case 25: return 6500;
+        case 27: return 8600;
+        case 28: return 2900;
+        case 29: return 7000;
+        default: return 0;
+    }
+}
+inline void dm_mark(int i) {
+    g_dm += dm_cost(g_dm_sec);
+    g_dm_sec = i;
+}
+inline void dm_turn_start() { g_dm = 0; g_dm_sec = 0; ++g_dm_turn; }
+inline bool fuel_okc(std::uint64_t need, std::uint64_t charge) {
+    g_dm += DM_CALL;
+    const std::uint64_t q = g_dm_turn <= 1 ? 2 * DM_Q : DM_Q;
+    if (g_dm + need + FUEL_RESERVE >= q) return false;
+    if (bc::fuel_remaining() <= DM_EMERG) { ++g_dm_emerg; return false; }
+    g_dm += charge;  // the work this check lets through
+    return true;
+}
+inline bool fuel_ok(std::uint64_t need) { return fuel_okc(need, 0); }
 
