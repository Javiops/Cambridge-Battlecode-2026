+// fuelfit-v1: the visible champions of a side, re-read only when that side's champion tiles changed this turn
+// (the SDK rebuilds the list from the tiles on every call, ~3000 fuel with 4 in view, 6.5 calls on a heavy turn).
+int g_ward_n = 0, g_kill = 0;
+template <class T> T& dm_use(T& x) { ++g_kill; return x; }
+template <class T> const T& dm_use(const T& x) { ++g_kill; return x; }
+const std::vector<bc::champion>& vis_champions(bc::team side) {
+    static int r[2] = {-1, -1}, kx[2], ky[2], kw[2], kk[2];
+    static std::vector<bc::champion> val[2];
+    const int i = side == bc::team::ally ? 0 : 1;
+    const int round = static_cast<int>(bc::round_number());
+    const vec2 mp = bc::self().position();
+    if (r[i] == round && kx[i] == X(mp) && ky[i] == Y(mp) && kw[i] == g_ward_n && kk[i] == g_kill) return val[i];
+    const auto ps = bc::vision::champion_tiles(side).positions();
+    val[i].clear();
+    val[i].reserve(ps.size());
+    for (const auto p : ps) val[i].push_back(bc::vision::champion_at(p));
+    r[i] = round; kx[i] = X(mp); ky[i] = Y(mp); kw[i] = g_ward_n; kk[i] = g_kill;
+    return val[i];
+}
