+inline int dist(vec2 a, vec2 b) {  // fuelfit o44: 32-bit Chebyshev distance (same value as vec2::chebyshev_distance)
+    const int dx = a.x > b.x ? a.x - b.x : b.x - a.x, dy = a.y > b.y ? a.y - b.y : b.y - a.y;
+    return dx > dy ? dx : dy;
