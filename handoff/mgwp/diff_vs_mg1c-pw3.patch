 }
+int g_wp = 0;  // waitpair-v1: rounds waiting for a respawn next to an ally
 int g_pw = 0;  // pairfarm-v3: rounds spent walking toward an ally
 // pairfarm-v4: where each ally probably is. Allies out of vision have no position; their claim says where they go.
 // Seen: its real position. Unseen: one tile a round from where it was last placed toward the centre of its claimed group.
@@ -3222,6 +3223,25 @@
         // turn, dropped it again... and stood still for 30-50 rounds (elk_arena, 4.3k champion-rounds / 20 games).
         if (g.next_ok <= round + std::max(dist(pos, g.center), s.target_gd) + P_RESPAWN) {
             g_farm = "wait-respawn";  // stand 2-3 tiles off its spawn tiles until it is back
+            // waitpair-v1 (near maps r30-150: 63% of our wait-respawn rounds have no ally within 4): with time to spare,
