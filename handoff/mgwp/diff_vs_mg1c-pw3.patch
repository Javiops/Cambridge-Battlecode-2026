+                    const vec2 ap(g_pe[k].x, g_pe[k].y);
+                    const int d = dist(ap, g.center);
+                    if (d >= 3 && d <= P_WAITPAIR_D && d + 2 <= wait && d < md && !s.my_spawn.is_set(ap)) { md = d; mate = ap; }
