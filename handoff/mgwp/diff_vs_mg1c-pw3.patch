                 r3.draw_chebyshev(t, 3.0f);
@@ -4636,7 +4656,7 @@
                 if (!(a == me) && a.is_alive()) md = std::min(md, dist(a.position(), me.position()));
             ++n; alone += md > 4; dsum += md;
