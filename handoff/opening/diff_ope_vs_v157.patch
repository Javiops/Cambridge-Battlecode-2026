+// opening-near-v1: walking length between the spawn regions, read once (same field as the draft's).
+inline int op_spawn_path() {
+    static int sp = -2;
+    if (sp == -2) {
+        sp = -1;
+        attempt([&] {
+            bc::bitboard block = bc::map::walls() | bc::map::holes() | bc::map::altars();
+            bc::distance_field da;
+            bc::bitboard va;
+            da.compute(block, bc::map::spawn_region(bc::team::ally), va);
+            int ab = 1 << 30;
+            for (auto p : bc::map::spawn_region(bc::team::enemy).positions())
+                if (va.is_set(p)) ab = std::min(ab, static_cast<int>(da.get(p)));
+            if (ab < (1 << 30)) sp = ab;
+            return true;
+        });
+    }
+    return sp;
+}
+// opening-near-v1 (top 10 near maps: Vendetta first camp hit r6 vs our r24, HoR r11 vs r22, monster damage r20 534 vs
+// 160 for Vendetta; no item is bought before r40; our first 5 groups 17.2 tiles from spawn vs 14.6): until P_OP_UNTIL
+// the heavy farmers price far groups down, so they start on the camps next to spawn.
+inline bool op_on(const State& s, int round) {
+    if (!P_OP || round > P_OP_UNTIL) return false;
+    if (P_OP_HEAVY && s.name.rfind("vend", 0) != 0 && s.name.rfind("heart", 0) != 0 && s.name.rfind("marc", 0) != 0) return false;
+    const int sp = op_spawn_path();
+    return sp >= 0 && sp < P_OP_MAX;
+}
