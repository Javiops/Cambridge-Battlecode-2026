+// v11d: combined health of the alive squad members (not recalling, off the spawn) within r of a tile, me counted as my_hp
+inline double squad_hp_near(vec2 at, int r, int me_k, double my_hp) {
+    double h = 0;
+    for (int i = 0; i < g_nsq; ++i) {
+        const int k = g_squad[i];
+        const Ally& a = g_al[k];
+        if (k == me_k) { h += my_hp; continue; }
+        if (!a.alive || a.recalling || a.home || !a.seen) continue;
+        if (dist(a.p, at) <= r) h += a.hp;
+    }
+    return h;
+}
