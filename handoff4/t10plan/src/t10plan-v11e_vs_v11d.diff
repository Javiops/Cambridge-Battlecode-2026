+inline int carrier_k(int me_k) {
+    int c = -1, tg = 0;
+    for (int i = 0; i < g_nsq; ++i) { const int k = g_squad[i]; if (k != me_k && g_al[k].alive && g_al[k].gems > tg) { tg = g_al[k].gems; c = k; } }
+    return c;
+}
+inline double block_dps_all(int me_k) {
+    double d = 0; const int c = carrier_k(me_k);
+    for (int i = 0; i < g_nsq; ++i) { const int k = g_squad[i]; const Ally& a = g_al[k]; if (k == me_k) { d += a.dps; continue; } if (!a.alive || a.recalling || k == c) continue; d += a.dps; }
+    return d;
+}
+inline double block_hp_all(int me_k, double my_hp) {
+    double h = 0; const int c = carrier_k(me_k);
+    for (int i = 0; i < g_nsq; ++i) { const int k = g_squad[i]; const Ally& a = g_al[k]; if (k == me_k) { h += my_hp; continue; } if (!a.alive || a.recalling || k == c) continue; h += a.hp; }
+    return h;
+}
