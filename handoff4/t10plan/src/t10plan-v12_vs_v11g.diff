 #define P_V11_NEAR 15     // v11c: the next target is within this walk of the leader when one of P_V11_MINVAL+ exists, else the nearest
 #define P_V11_SOLO 5      // v11c: rounds a member may hit a damaged camp with no ally within 4 before it rallies (camp >= 40%)
 #define P_V11_TCLEAR 35   // v11e: a block target must be clearable in this many rounds with the dps of ALL alive block members (roster, minus the carrier), costing < 80% of the block's health; else the best-ratio group anyway
-#define P_V11_BIG 80      // rival-side groups of this value are contested before r300 with a full block and no rival pack
+#define P_V11_BIG 80
+// t10plan-v12: synchronized engage (the block hits a camp only once every member targeting it is at the ring, capped) and
+// one waiter per reward (the others lock the next group within P_V12_NEXT at once). P_V12 0: v11g play.
+#define P_V12 1
+#define P_V12_SYNC_D 2    // a member has arrived when within camp range + this of a live camp of the target
+#define P_V12_SYNC_WAIT 6 // rounds the block waits for the rest from the first arrival
+#define P_V12_NEXT 16     // the non-waiting members lock the next live group within this of the captured one      // rival-side groups of this value are contested before r300 with a full block and no rival pack
