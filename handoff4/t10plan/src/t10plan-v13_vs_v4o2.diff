+// v13-shop (shop(), from P_V13_R): the champion's plan becomes the top-20 rivals' observed purchase order (replays_c37,
+// 160 games vs ranks 5-20, an/shop13plan.py: modal item of the k-th purchase event, deduplicated, then the r300-600 fill).
+// Swapped at the first shop() call of round >= P_V13_R so init stays byte-identical to v4o2. Returns false = plan kept.
+CHAMP_HOOK bool v13_plan(State& s) {
+    return P_V13 && (vesper::shop_plan(s, true) || vendetta::shop_plan(s, true) || marcella::shop_plan(s, true) ||
+                     ryth::shop_plan(s, true) || heart_of_ruin::shop_plan(s, true));
+}
+
+// v13-shop: gold the rival has when it buys its first shards (p25 of the first purchase event per champion type):
+// Vesper 79, Marcella 80, Ryth / Vendetta / HoR 40. Below it the champion does not buy (from P_V13_R).
+CHAMP_HOOK int v13_gold_floor(const State& s) {
+    if (vesper::is(s.name)) return 79;
+    if (marcella::is(s.name)) return 80;
+    if (ryth::is(s.name) || vendetta::is(s.name) || heart_of_ruin::is(s.name)) return 40;
+    return 30;
+}
+
 // Shop, every buy (shop()): true = the champion's own plan holds its health shards, so hp_pick is off.
 CHAMP_HOOK bool own_plan(const State& s) {
-    return P_T10SHOP && (vendetta::is(s.name) || marcella::is(s.name) || ryth::is(s.name) || heart_of_ruin::is(s.name));
+    return P_T10SHOP && (vendetta::is(s.name) || marcella::is(s.name) || ryth::is(s.name) || heart_of_ruin::is(s.name) ||
+                         (P_V13 && vesper::is(s.name)));  // v13-shop: Vesper's plan holds her health shards (durab-h)
 }
 
