+    bool leave = (n >= 2 && r < P_V14_RATIO) || (al == 0 && hpr * 100 < P_V14_LOWHP && r < 100);
+    g_v16 = false;
+    if (!leave && P_V16 && round >= P_V16_R && n >= 2 && r < P_V16_RATIO) {
+        int dd = 99;
+        for (auto& f : foes)
