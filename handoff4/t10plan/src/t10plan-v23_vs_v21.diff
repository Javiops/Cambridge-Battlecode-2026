diff -u v21/src/fight.h v23/src/fight.h
--- v21/src/fight.h	2026-10-29 18:46:31.089344549 +0000
+++ v23/src/fight.h	2026-10-29 19:29:26.767655066 +0000
@@ -567,6 +567,18 @@
         if (!cast && dist(pos, focus->p) <= SPELL_RANGE) try_use(true, focus);
     }
 
+    // t10plan-v23: a ranged champion that stepped cannot shoot; the attack reset gives the shot back (engine: Vesper's reset
+    // allows an attack after a step). Online v17: our Vesper shot in 32 of 100 fight turns, rival Vespers in 49.
+    if (P_V23 && range > 1 && !me.can_attack() && s.reset_slot >= 0 && me.can_cast() && dist(pos, focus->p) <= range &&
+        fuel_ok(9000)) {
+        auto rab = me.abilities()[s.reset_slot];
+        if (attempt([&] { return rab.is_ready(); }) && attempt([&] { return dm_use(rab).use(); })) {
+            static int v23n = 0;
+            if (++v23n <= 3 || v23n % 50 == 0) std::printf("[v23-reset] r=%d n=%d\n", round, v23n);
+            attempt([&] { dm_use(me).attack(focus->c); return true; });
+            return true;
+        }
+    }
     if (dist(pos, focus->p) <= range) basic_attack(s, me, focus->c, focus->p);  // 3. shoot
     else hit_any(s, me, near);
     return true;
