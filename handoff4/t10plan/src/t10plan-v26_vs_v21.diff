diff -u v21/src/main.cpp v26/src/main.cpp
--- v21/src/main.cpp	2026-10-29 18:46:31.133883979 +0000
+++ v26/src/main.cpp	2026-10-29 20:37:55.094151022 +0000
@@ -2269,6 +2269,13 @@
         s.slots[1] == Slot::Ground)
         d += me.focus() * 1.5 / 8.0;
     if (varg::splashes(s)) d *= varg::SPLASH;
+    // t10plan-v22: HoR's dash is her damage spell (camp hit 132-136 online) and was not in the estimate, so squad
+    // admission saw her at strength 30 and she farmed 2.7x fewer camp attacks than rival HoRs (22 vs 59 a game r30-300).
+    if (P_V22 && s.dash_slot >= 0 && starts_with(s.name, "heart")) {
+        double dd = 0;
+        attempt([&] { dd = me.abilities()[s.dash_slot].damage_amount(); return true; });
+        d += dd * P_V22_DASHW / 100.0;
+    }
     return std::max(d, 10.0);
 }
 
