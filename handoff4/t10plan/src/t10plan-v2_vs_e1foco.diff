+// t10plan-v1: the top-10 teams' camp schedule (plan_t10.h). Matched once per game: the map whose group centres all
+// sit within 2 tiles of ours, the side whose spawn centre is nearest ours. pl_w(i, round) is the group's share of the
+// top-10 camp-hit champion-rounds in this 50-round window, in % of the window's main group (-1: no plan for the map).
+#include "plan_t10.h"
+const plan_t10::Map* g_pl_map = nullptr;
+int g_pl_side = 0, g_pl_state = 0;  // state 0 not matched yet, 1 matched, 2 no plan
+std::vector<int> g_pl_idx;           // our group -> plan group
+int g_pl_on = 0, g_pl_off = 0;       // choices on / off the plan
+void pl_match(State& s) {
+    g_pl_state = 2;
+    const int ng = static_cast<int>(s.groups.size());
+    for (int m = 0; m < plan_t10::NMAPS; ++m) {
+        const plan_t10::Map& M = plan_t10::MAPS[m];
+        if (M.ng != ng) continue;
+        std::vector<int> idx(ng, -1);
+        bool ok = true;
+        for (int i = 0; i < ng && ok; ++i) {
+            int best = -1, bd = 3;
+            for (int k = 0; k < ng; ++k) {
+                const int d = std::max(std::abs(X(s.groups[i].center) - M.gx[k]), std::abs(Y(s.groups[i].center) - M.gy[k]));
+                if (d < bd) { bd = d; best = k; }
+            }
+            ok = best >= 0; idx[i] = best;
+        }
+        if (!ok) continue;
+        g_pl_map = &M; g_pl_idx = idx; g_pl_state = 1;
+        const vec2 c = s.spawn_center;
+        const int d0 = std::max(std::abs(X(c) - M.sx[0]), std::abs(Y(c) - M.sy[0]));
+        const int d1 = std::max(std::abs(X(c) - M.sx[1]), std::abs(Y(c) - M.sy[1]));
+        g_pl_side = d1 < d0 ? 1 : 0;
+        break;
+    }
+    std::printf("[t10plan] who=%s map=%s side=%d games=%d groups=%d\n", s.name.c_str(), g_pl_map ? g_pl_map->name : "none",
+                g_pl_side, g_pl_map ? g_pl_map->games : 0, ng);
+}
+inline int pl_w(State& s, int i, int round) {
+    if (!P_T10PLAN || round >= P_T10_UNTIL) return -1;
+    if (g_pl_state == 0) pl_match(s);
+    if (g_pl_state != 1 || i < 0 || i >= static_cast<int>(g_pl_idx.size())) return -1;
+    const plan_t10::Map& M = *g_pl_map;
+    const int b = std::min(plan_t10::NB - 1, std::max(0, round) / 50);
+    const unsigned char* row = M.share + (g_pl_side * plan_t10::NB + b) * M.ng;
+    static int mx_b = -1, mx = 0;  // the window's main share, once per window
+    if (mx_b != b) { mx_b = b; mx = 0; for (int k = 0; k < M.ng; ++k) mx = std::max(mx, static_cast<int>(row[k])); }
+    if (mx == 0) return -1;
+    return 100 * row[g_pl_idx[i]] / mx;
+}
