+// v3: matched by camp positions (the replay's group ids are unreliable): every plan camp must stand on (or next to) a tile
+// of one of our groups, and the camp counts must agree.
+void pl_match(State& s) {
+    g_pl_state = 2;
+    const int ng = static_cast<int>(s.groups.size());
+    int ncamps = 0;
+    for (auto& g : s.groups) ncamps += g.members;
+    int tried = 0;
+    for (int m = 0; m < plan_t10::NMAPS; ++m) {
+        const plan_t10::Map& M = plan_t10::MAPS[m];
+        if (M.nc != ncamps) continue;
+        ++tried;
+        std::vector<int> owner(M.nc, -1);
+        bool ok = true;
+        for (int c = 0; c < M.nc && ok; ++c) {
+            int bd = 2;
+            for (int i = 0; i < ng; ++i)
+                for (auto t : s.groups[i].tiles) {
+                    const int d = std::max(std::abs(X(t) - M.cx[c]), std::abs(Y(t) - M.cy[c]));
+                    if (d < bd) { bd = d; owner[c] = i; }
+                }
+            ok = owner[c] >= 0;
+        }
+        if (!ok) continue;
+        g_pl_map = &M; g_pl_state = 1;
+        const vec2 cc = s.spawn_center;
+        const int d0 = std::max(std::abs(X(cc) - M.sx[0]), std::abs(Y(cc) - M.sy[0]));
+        const int d1 = std::max(std::abs(X(cc) - M.sx[1]), std::abs(Y(cc) - M.sy[1]));
+        g_pl_side = d1 < d0 ? 1 : 0;
+        g_pl_gs.assign(plan_t10::NB * ng, 0);
+        g_pl_mx.assign(plan_t10::NB, 0);
+        for (int bn = 0; bn < plan_t10::NB; ++bn) {
+            const unsigned char* row = M.share + (g_pl_side * plan_t10::NB + bn) * M.nc;
+            for (int c = 0; c < M.nc; ++c) g_pl_gs[bn * ng + owner[c]] += row[c];
+            for (int i = 0; i < ng; ++i) g_pl_mx[bn] = std::max(g_pl_mx[bn], g_pl_gs[bn * ng + i]);
+        }
+        break;
+    }
+    std::printf("[t10plan] who=%s map=%s side=%d games=%d groups=%d camps=%d tried=%d\n", s.name.c_str(), g_pl_map ? g_pl_map->name : "none",
+                g_pl_side, g_pl_map ? g_pl_map->games : 0, ng, ncamps, tried);
+}
+// t10plan-v3: the plan fades out linearly from P_T10_UNTIL to P_T10_END (100 = full weight), no cliff at r650
+inline int pl_fade(int round) {
+    if (round < P_T10_UNTIL) return 100;
+    if (round >= P_T10_END) return 0;
+    return 100 * (P_T10_END - round) / (P_T10_END - P_T10_UNTIL);
+}
+inline bool pl_carry(const std::string& n) { return starts_with(n, "vesper") || starts_with(n, "marcella"); }
+inline int pl_w(State& s, int i, int round) {
+    if (!P_T10PLAN || round >= P_T10_END || round < P_T10_FROM) return -1;
+    if (g_pl_state == 0) pl_match(s);
+    if (P_T10_FARCUT) { const int sp = pf_spawn_path(); if (sp < 0 || sp >= P_T10_FARCUT) return -1; }
+    const int ng = static_cast<int>(s.groups.size());
+    if (g_pl_state != 1 || i < 0 || i >= ng) return -1;
+    const int b = std::min(plan_t10::NB - 1, std::max(0, round) / 50);
+    if (g_pl_mx[b] <= 0) return -1;
+    return 100 * g_pl_gs[b * ng + i] / g_pl_mx[b];
+}
