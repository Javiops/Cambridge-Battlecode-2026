+                    const int d = std::max(std::abs(X(t) - M.cx[c]), std::abs(Y(t) - M.cy[c]));
+                    if (d < bd) { bd = d; owner[c] = i; }
+                }
+            ok = owner[c] >= 0;
+        }
+        if (!ok) continue;
+        g_pl_map = &M; g_pl_state = 1;
+        const vec2 cc = s.spawn_center;
+        const int d0 = std::max(std::abs(X(cc) - M.sx[0]), std::abs(Y(cc) - M.sy[0]));
+        const int d1 = std::max(std::abs(X(cc) - M.sx[1]), std::abs(Y(cc) - M.sy[1]));
+        g_pl_side = d1 < d0 ? 1 : 0;
+        g_pl_gs.assign(plan_t10::NB * ng, 0);
+        g_pl_mx.assign(plan_t10::NB, 0);
+        for (int bn = 0; bn < plan_t10::NB; ++bn) {
+            const unsigned char* row = M.share + (g_pl_side * plan_t10::NB + bn) * M.nc;
+            for (int c = 0; c < M.nc; ++c) g_pl_gs[bn * ng + owner[c]] += row[c];
+            for (int i = 0; i < ng; ++i) g_pl_mx[bn] = std::max(g_pl_mx[bn], g_pl_gs[bn * ng + i]);
+        }
