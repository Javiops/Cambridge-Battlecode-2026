+// v9c: combined dps of the alive squad members (not recalling, off the spawn) within r of a tile (me always counted)
+inline int squad_dps_near(vec2 at, int r, int me_k) {
+    double d = 0;
+    for (int i = 0; i < g_nsq; ++i) {
+        const int k = g_squad[i];
+        const Ally& a = g_al[k];
+        if (k == me_k) { d += a.dps; continue; }
+        if (!a.alive || a.recalling || a.home || !a.seen) continue;
+        if (dist(a.p, at) <= r) d += a.dps;
+    }
+    return static_cast<int>(d);
